# 虚拟环境与缓存
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 大文件：权重与中间产物（可由脚本重新生成/下载）
cache/
*.safetensors
*.gguf
*.bin
*.pt
*.log

# 本地会话缓存（KV 文件很大，session 映射是机器本地状态）
.kvcache/*.pt
.kvcache/*.db

# 本地配置
.env
config.local.*
# 本地临时脚本（bench/prof 之类，不入库）
_*.py
_*.txt

# trace 产物
_*.json

# 编译产物：kernel 的 cubin 由 scripts/build_native.ps1 生成
*.cubin

# 服务端日志
serve.log
serve.err.log

# 厂商参考实现（DeepSeek 官方 minimal inference），仅本地比对用，不随本仓库分发
reference/

# 早期 kernel 实验（import 会失败，不是引擎的一部分）
prototypes/
