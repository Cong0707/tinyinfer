# 虚拟环境与缓存
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 大文件：权重与中间产物（可由脚本重新生成/下载）
cache/
*.safetensors
*.gguf
*.bin
*.pt
*.log

# 本地会话缓存（KV 文件很大，session 映射是机器本地状态）
.kvcache/*.pt
.kvcache/*.db

# 本地配置
.env
config.local.*
# 本地临时脚本（bench/prof 之类，不入库）
_*.py
_*.txt

# trace 产物
_*.json

# 编译产物：kernel 的 cubin 由 scripts/build_native.ps1 生成
*.cubin

# 服务端日志
serve.log
serve.err.log

# 厂商参考实现（DeepSeek 官方 minimal inference）。整目录是本地比对用的，但
# kernels/sparse_attn.py 和好几处 attention 直接 import 它的 act_quant /
# fp4_act_quant，所以 kernel.py 是硬依赖——排除它会让 clone 下来的仓库在 prefill
# 阶段 ImportError。只把这一个文件纳入版本控制。
reference/*
!reference/official/
reference/official/*
!reference/official/kernel.py
reference/official/__pycache__/

# 早期 kernel 实验（import 会失败，不是引擎的一部分）
prototypes/

# 手工编译的 vLLM 扩展（34 MB）：由 docs/vllm-extension-build.md 里的流程重建。
# 不入库，但要跟着源码目录放，tinyinfer 优先从包内加载。
src/tinyinfer/_C_stable_libtorch.pyd
src/tinyinfer/_moe_C_stable_libtorch.pyd